{
  "dashboard": {
    "title": "HomeSweetHome - Community Domain Performance",
    "tags": ["community", "spring-boot", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    },
    "panels": [
      {
        "id": 1,
        "title": "Application Status",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "up{job=\"homesweet-backend\"}",
            "legendFormat": "Status",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "value": "0", "text": "DOWN" },
              { "type": "value", "value": "1", "text": "UP" }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Requests Per Second (RPS)",
        "type": "graph",
        "gridPos": { "x": 6, "y": 0, "w": 9, "h": 4 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\"}[1m]))",
            "legendFormat": "Total RPS",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\",status=~\"2..\"}[1m]))",
            "legendFormat": "Success (2xx)",
            "refId": "B"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\",status=~\"4..\"}[1m]))",
            "legendFormat": "Client Error (4xx)",
            "refId": "C"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\",status=~\"5..\"}[1m]))",
            "legendFormat": "Server Error (5xx)",
            "refId": "D"
          }
        ]
      },
      {
        "id": 3,
        "title": "HTTP Error Rate (%)",
        "type": "stat",
        "gridPos": { "x": 15, "y": 0, "w": 4, "h": 4 },
        "targets": [
          {
            "expr": "(sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/.*\"}[5m]))) * 100",
            "legendFormat": "Error Rate",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "green" },
                { "value": 1, "color": "yellow" },
                { "value": 5, "color": "red" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Active Virtual Users (VUs)",
        "type": "stat",
        "gridPos": { "x": 19, "y": 0, "w": 5, "h": 4 },
        "targets": [
          {
            "expr": "jvm_threads_live_threads",
            "legendFormat": "Active Threads",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "API Response Time (p50, p95, p99)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 4, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/community/.*\"}[5m])) by (le, uri))",
            "legendFormat": "p50 - {{uri}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/community/.*\"}[5m])) by (le, uri))",
            "legendFormat": "p95 - {{uri}}",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_seconds_bucket{uri=~\"/api/v1/community/.*\"}[5m])) by (le, uri))",
            "legendFormat": "p99 - {{uri}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "Response Time" }
        ]
      },
      {
        "id": 6,
        "title": "Community API Request Rate by Endpoint",
        "type": "graph",
        "gridPos": { "x": 12, "y": 4, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/posts$\",method=\"POST\"}[1m]))",
            "legendFormat": "Create Post",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/posts$\",method=\"GET\"}[1m]))",
            "legendFormat": "List Posts",
            "refId": "B"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/posts/.*/comments\",method=\"POST\"}[1m]))",
            "legendFormat": "Create Comment",
            "refId": "C"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/posts/.*/likes\",method=\"POST\"}[1m]))",
            "legendFormat": "Toggle Post Like",
            "refId": "D"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/v1/community/posts/.*/views\",method=\"POST\"}[1m]))",
            "legendFormat": "Increase Views",
            "refId": "E"
          }
        ]
      },
      {
        "id": 7,
        "title": "JVM Heap Memory Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 10, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"}",
            "legendFormat": "Used",
            "refId": "A"
          },
          {
            "expr": "jvm_memory_committed_bytes{area=\"heap\"}",
            "legendFormat": "Committed",
            "refId": "B"
          },
          {
            "expr": "jvm_memory_max_bytes{area=\"heap\"}",
            "legendFormat": "Max",
            "refId": "C"
          }
        ],
        "yaxes": [
          { "format": "bytes", "label": "Memory" }
        ]
      },
      {
        "id": 8,
        "title": "GC Pause Time",
        "type": "graph",
        "gridPos": { "x": 8, "y": 10, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
            "legendFormat": "{{action}} - {{cause}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "s", "label": "GC Time" }
        ]
      },
      {
        "id": 9,
        "title": "Database Connection Pool",
        "type": "graph",
        "gridPos": { "x": 16, "y": 10, "w": 8, "h": 6 },
        "targets": [
          {
            "expr": "hikaricp_connections_active",
            "legendFormat": "Active",
            "refId": "A"
          },
          {
            "expr": "hikaricp_connections_idle",
            "legendFormat": "Idle",
            "refId": "B"
          },
          {
            "expr": "hikaricp_connections_max",
            "legendFormat": "Max",
            "refId": "C"
          },
          {
            "expr": "hikaricp_connections_min",
            "legendFormat": "Min",
            "refId": "D"
          }
        ]
      },
      {
        "id": 10,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage %",
            "refId": "A"
          }
        ],
        "yaxes": [
          { "format": "percent", "label": "CPU %" }
        ]
      },
      {
        "id": 11,
        "title": "System Memory Usage",
        "type": "graph",
        "gridPos": { "x": 8, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
            "legendFormat": "Used",
            "refId": "A"
          },
          {
            "expr": "node_memory_MemAvailable_bytes",
            "legendFormat": "Available",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "bytes", "label": "Memory" }
        ]
      },
      {
        "id": 12,
        "title": "Disk I/O",
        "type": "graph",
        "gridPos": { "x": 16, "y": 16, "w": 8, "h": 5 },
        "targets": [
          {
            "expr": "rate(node_disk_read_bytes_total[1m])",
            "legendFormat": "Read",
            "refId": "A"
          },
          {
            "expr": "rate(node_disk_written_bytes_total[1m])",
            "legendFormat": "Write",
            "refId": "B"
          }
        ],
        "yaxes": [
          { "format": "Bps", "label": "I/O" }
        ]
      },
      {
        "id": 13,
        "title": "Top 10 Slowest API Endpoints",
        "type": "table",
        "gridPos": { "x": 0, "y": 21, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/community/.*\"}[5m])) by (le, uri, method)))",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A",
            "format": "table",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "method": "Method",
                "uri": "Endpoint",
                "Value": "p95 Response Time (s)"
              }
            }
          }
        ]
      },
      {
        "id": 14,
        "title": "Error Logs (Last 100)",
        "type": "logs",
        "gridPos": { "x": 12, "y": 21, "w": 12, "h": 6 },
        "targets": [
          {
            "expr": "{job=\"homesweet-backend\",level=\"ERROR\"}",
            "refId": "A"
          }
        ],
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending"
        }
      }
    ]
  },
  "overwrite": true
}
